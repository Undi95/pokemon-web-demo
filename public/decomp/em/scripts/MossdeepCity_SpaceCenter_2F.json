ADE_TO_BLACK","setflag FLAG_DEFEATED_MAGMA_SPACE_CENTER","setflag FLAG_HIDE_MOSSDEEP_CITY_STEVENS_HOUSE_STEVEN","removeobject LOCALID_SPACE_CENTER_2F_STEVEN","setflag FLAG_HIDE_MOSSDEEP_CITY_SPACE_CENTER_MAGMA_NOTE","clearflag FLAG_HIDE_MOSSDEEP_CITY_STEVENS_HOUSE_STEVEN","setvar VAR_STEVENS_HOUSE_STATE, 1","setflag FLAG_HIDE_MOSSDEEP_CITY_SCOTT","removeobject LOCALID_SPACE_CENTER_2F_SCIENTIST","setobjectxyperm LOCALID_SPACE_CENTER_2F_SCIENTIST, 5, 6","setobjectmovementtype LOCALID_SPACE_CENTER_2F_SCIENTIST, MOVEMENT_TYPE_WANDER_AROUND","addobject LOCALID_SPACE_CENTER_2F_SCIENTIST","fadescreen FADE_FROM_BLACK","#ifdef BUGFIX","releaseall","#endif","end"],"MossdeepCity_SpaceCenter_2F_EventScript_StevenFacePlayer":["switch VAR_FACING","case DIR_SOUTH, MossdeepCity_SpaceCenter_2F_EventScript_StevenFacePlayerSouth","case DIR_WEST, MossdeepCity_SpaceCenter_2F_EventScript_StevenFacePlayerWest","return"],"MossdeepCity_SpaceCenter_2F_EventScript_StevenFacePlayerSouth":["turnobject LOCALID_SPACE_CENTER_2F_STEVEN, DIR_NORTH","return"],"MossdeepCity_SpaceCenter_2F_EventScript_StevenFacePlayerWest":["turnobject LOCALID_SPACE_CENTER_2F_STEVEN, DIR_EAST","return"],"MossdeepCity_SpaceCenter_2F_EventScript_MaxieTrainer":["trainerbattle TRAINER_BATTLE_SET_TRAINER_A, TRAINER_MAXIE_MOSSDEEP, LOCALID_NONE, MossdeepCity_SpaceCenter_2F_Text_JustWantToExpandLand, MossdeepCity_SpaceCenter_2F_Text_JustWantToExpandLand","end"],"MossdeepCity_SpaceCenter_2F_EventScript_TabithaTrainer":["trainerbattle TRAINER_BATTLE_SET_TRAINER_B, TRAINER_TABITHA_MOSSDEEP, LOCALID_NONE, MossdeepCity_SpaceCenter_Text_TabithaDefeat, MossdeepCity_SpaceCenter_Text_TabithaDefeat","end"],"MossdeepCity_SpaceCenter_2F_EventScript_RivalRayquazaCall":["lockall","checkplayergender","call_if_eq VAR_RESULT, MALE, MossdeepCity_SpaceCenter_2F_EventScript_MayRayquazaCall","call_if_eq VAR_RESULT, FEMALE, MossdeepCity_SpaceCenter_2F_EventScript_BrendanRayquazaCall","closemessage","clearflag FLAG_DEFEATED_MAGMA_SPACE_CENTER","releaseall","end"],"MossdeepCity_SpaceCenter_2F_EventScript_MayRayquazaCall":["pokenavcall MatchCall_Text_MayRayquazaCall","waitmessage","return"],"MossdeepCity_SpaceCenter_2F_EventScript_BrendanRayquazaCall":["pokenavcall MatchCall_Text_BrendanRayquazaCall","waitmessage","return"]},"texts":{"MossdeepCity_SpaceCenter_2F_OnTransition":"","MossdeepCity_SpaceCenter_2F_OnFrame":"","MossdeepCity_SpaceCenter_2F_Movement_PlayerExit":"","MossdeepCity_SpaceCenter_2F_Movement_Grunt6Defeated":"","MossdeepCity_SpaceCenter_2F_Movement_Grunt5Defeated":"","MossdeepCity_SpaceCenter_2F_Movement_Grunt7Defeated":"","MossdeepCity_SpaceCenter_2F_Movement_StevenFight":"","MossdeepCity_SpaceCenter_2F_Movement_StevenFightSouth":"","MossdeepCity_SpaceCenter_2F_Text_MossdeepIdealForRockets":"A ALGATIA, le temps est souvent\\nensoleillé et les vents sont stables.\\pC'est l'endroit idéal pour lancer des\\nfusées.$","MossdeepCity_SpaceCenter_2F_Text_WhyWouldMagmaStealRocketFuel":"Mais pourquoi la TEAM MAGMA veut\\nnous voler notre carburant?$","MossdeepCity_SpaceCenter_2F_Text_WouldveLikedToBeAstronaut":"Si j'avais été un peu plus jeune,\\nj'aurais bien aimé être astronaute…\\pNon… Il n'est pas trop tard!\\nJe vais essayer!$","MossdeepCity_SpaceCenter_2F_Text_MagmaCantGetAwayWithThis":"Si la TEAM MAGMA vole notre carburant,\\nje ne pourrai jamais aller dans l'espace!\\pOn ne peut pas les laisser partir\\ncomme ça!$","MossdeepCity_SpaceCenter_2F_Text_WishOrdinaryPeopleCouldGoIntoSpace":"J'espère qu'un jour, tout le monde\\npourra aller dans l'espace…$","MossdeepCity_SpaceCenter_2F_Text_DoesMagmaWantToGoToSpace":"Est-ce que la TEAM MAGMA souhaite\\négalement aller dans l'espace?$","MossdeepCity_SpaceCenter_2F_Text_YoureOutnumberedTakeUsOn":"C'est quoi ton problème?\\pTu es à un contre trois mais tu veux\\nquand même te battre?$","MossdeepCity_SpaceCenter_2F_Text_GoodAnswer":"Bonne réponse! Tu n'es pas aussi\\nstupide que je pensais.$","MossdeepCity_SpaceCenter_2F_Text_Grunt5Intro":"Plutôt téméraire à ce que je vois…\\nOK, à moi l'honneur alors!$","MossdeepCity_SpaceCenter_2F_Text_Grunt5Defeat":"J'ai perdu!\\nMais…$","MossdeepCity_SpaceCenter_2F_Text_Grunt6Intro":"Il est trop tôt pour te réjouir!\\nJe suis le suivant.$","MossdeepCity_SpaceCenter_2F_Text_Grunt6Defeat":"J'ai perdu aussi!\\nMais…$","MossdeepCity_SpaceCenter_2F_Text_Grunt7Intro":"J'imagine que tu souhaites faire\\nune pause. Mais ne compte pas dessus.$","MossdeepCity_SpaceCenter_2F_Text_Grunt7Defeat":"On aurait dû faire une pause…\\nOn aurait vraiment dû…$","MossdeepCity_SpaceCenter_2F_Text_Grunt6PostBattle":"On était trois, et regarde le résultat…$","MossdeepCity_SpaceCenter_2F_Text_Grunt7PostBattle":"Perdre à trois contre un…\\nOn est trois fois plus ridicules.$","MossdeepCity_SpaceCenter_2F_Text_Grunt5PostBattle":"Je me demande si on est vraiment\\nutiles à notre chef…$","MossdeepCity_SpaceCenter_2F_Text_WellTakeCareOfYou":"Héhéhé!\\pOn est venus jusqu'ici pour prendre le\\ncarburant, et tu es encore dans nos\\lpattes!\\pSi tu veux vraiment nous gêner, on va\\ns'occuper définitivement de toi!$","MossdeepCity_SpaceCenter_2F_Text_MaxieDontInterfere":"MAX: Hors de mon chemin!\\nN'essaie même pas d'intervenir!$","MossdeepCity_SpaceCenter_2F_Text_StevenWhyStealRocketFuel":"PIERRE: TEAM MAGMA…\\pPourquoi voulez-vous nous voler le\\ncarburant de notre fusée?$","MossdeepCity_SpaceCenter_2F_Text_MaxieUseFuelToEruptVolcano":"MAX: Ha ha ha… Puisque tu es si\\ncurieux, tu mérites une explication.\\pNous voulons tout déverser dans le\\nMONT CHIMNEE!\\pGROUDON parti, nous n'avons plus\\nbesoin de cette montagne!\\pAlors nous allons utiliser le carburant\\npour créer une énorme éruption!\\pÇa va être terrible!$","MossdeepCity_SpaceCenter_2F_Text_StevenAreYouReadyToBattle":"PIERRE: {PLAYER}{KUN}!\\nTu vas m'aider?\\pAffrontons-les ensemble!\\nOn y va maintenant?$","MossdeepCity_SpaceCenter_2F_Text_StevenHurryGetReadyQuickly":"PIERRE: Allez, dépêche-toi!\\nPrépare-toi vite!$","MossdeepCity_SpaceCenter_2F_Text_JustWantToExpandLand":"Tout ce que je souhaite…\\nC'est étendre la surface de la terre…$","MossdeepCity_SpaceCenter_Text_TabithaDefeat":"Je suis avec notre leader…$","MossdeepCity_SpaceCenter_2F_Text_MaxieWeFailedIsAquaAlsoMisguided":"MAX: Nous n'arriverons pas à faire\\nentrer le volcan en éruption…\\pNous n'avons pas réussi à contrôler\\nGROUDON après l'avoir réveillé…\\pAurions-nous tort de vouloir\\nétendre la terre?\\p… … … … … …\\n… … … … … …\\pSi…\\nSi nous, la TEAM MAGMA, avons tort…\\l… … … … … …\\pAlors que penser de la TEAM AQUA?$","MossdeepCity_SpaceCenter_2F_Text_MaxieWeWillGiveUp":"MAX: Très bien…\\nNous allons vous laisser le carburant.\\pIl y a des choses plus importantes\\nauxquelles je dois penser…$","MossdeepCity_SpaceCenter_2F_Text_StevenThankYouComeSeeMeAtHome":"PIERRE: Pfiuu, on a eu chaud!\\nMerci, {PLAYER}{KUN}!\\pJe voudrais te donner quelque chose\\npour te remercier de ton aide.\\pPasse me voir chez moi plus tard.\\pAh oui, je n'habite pas à MEROUVILLE,\\nmais bien ici, sur cette île.$"}}